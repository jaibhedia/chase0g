# ========================================
# NEXT.JS SHELL — environment variables
# ========================================
# Local dev: copy to `.env.local`. Production (Vercel): set these in
# Project → Settings → Environment Variables.

# ----------------------------------------
# Socket.IO backend (the Render service)
# ----------------------------------------
# Local dev:  http://localhost:3001

NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ----------------------------------------
# Game (Vite/Phaser) location
# ----------------------------------------
# Leave UNSET in production — the game is bundled into this app at
# /game-app/index.html and that path is the automatic prod default.
# Only set this if you host the game on a separate origin.
# NEXT_PUBLIC_GAME_URL=http://localhost:5173

# ----------------------------------------
# Supabase (optional — only if used)
# ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# ============================================================
# 0G — server-side ONLY. NEVER prefix these with NEXT_PUBLIC_
# and never put them in the game-app/Next bundles. A funded key
# leaked to the browser spends real testnet balance. Set these
# on the Render service (server/) env, copy to server/.env for
# local dev.
# ============================================================

# --- 0G Compute Router (Phase 1: AI agent brains) ---
# This project runs on TESTNET. Create a key at https://pc.testnet.0g.ai, deposit
# testnet 0G, copy the FULL secret shown once on creation, then the server talks
# OpenAI-compatible to the testnet router below.
#   Testnet: UI https://pc.testnet.0g.ai -> https://router-api-testnet.integratenetwork.work/v1
#   Mainnet: UI https://pc.0g.ai          -> https://router-api.0g.ai/v1
OG_ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
OG_ROUTER_API_KEY=your-router-api-key-here
# Exact chat model id from the Models page (e.g. qwen2.5-omni, which does NOT support
# JSON mode — the code already parses JSON from text).
OG_MODEL=qwen2.5-omni
# Seconds between agent-brain inference ticks (slow tier). Default 3.5.
OG_AGENT_TICK_SECONDS=3.5

# --- 0G testnet (Galileo) — Phase 2 Storage + Phase 3 Chain ---
OG_EVM_RPC=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# Funded testnet wallet the server uses to pay for Storage uploads
# and to post on-chain results. KEEP SECRET.
OG_PRIVATE_KEY=
# Deployed ChaseLeaderboard contract address (Phase 3)
OG_LEADERBOARD_ADDRESS=


# ============================================================
# ARC (Circle) — ETHOnline 2026. Server-side ONLY.
# Never prefix with NEXT_PUBLIC_. Arc gas is paid in real USDC.
# ============================================================

# --- Arc Testnet (chain 5042002) ---
# Faucet: https://faucet.circle.com  ·  Explorer: https://testnet.arcscan.app
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Deployer / settlement wallet. This wallet posts settle() for finished
# matches, so it is the escrow's authority. KEEP SECRET.
ARC_PRIVATE_KEY=

# Deployed ChaseStake escrow address
# Arc testnet, deployed Sep 8 2026, block 61111061
ARC_CHASESTAKE_ADDRESS=0xD648def45026f437351D797dC3574fa97507BA83

# --- Arc Mainnet (chain 5042) — A6, mainnet deadline Sep 30 ---
ARC_MAINNET_RPC_URL=https://rpc.arc.network

# NOTE: USDC on Arc is the native gas asset. The ERC-20 interface lives at
# 0x3600000000000000000000000000000000000000 (6 decimals) and is hardcoded —
# it is not configurable, so it is deliberately not an env var.


# ============================================================
# AI PROVIDER — the agent brains. Vendor-neutral.
# ============================================================
# Any OpenAI-compatible endpoint. Set these three and the agents work;
# swapping providers is an env change, not a code change.
#
#   OpenAI    : leave AI_BASE_URL unset, AI_MODEL=gpt-4o-mini
#   0G Compute: AI_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
#   any other : point AI_BASE_URL at its /v1
#
# If these are unset the server falls back to the OG_ROUTER_* vars above,
# so existing 0G deployments keep working unchanged.
# AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional label for /health and the in-game AI pill. Derived from the host if unset.
# AI_PROVIDER_NAME=
