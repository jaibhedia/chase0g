# ========================================
# GAME-APP (Vite/Phaser) — build-time env vars
# ========================================
# Vite inlines VITE_* vars at BUILD time. Local dev: copy to `.env.local`.
# Production (embedded build): set these in the Vercel project env so they're
# present when `npm run build:all` builds the game.

# Socket.IO backend — same URL as the Next shell's NEXT_PUBLIC_SOCKET_URL.
# Local dev:  http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Where the game returns to (lobby / results / main menu).
# Leave UNSET in production — the prod build defaults to '' = same-origin
# relative paths (the Next shell hosts the game on the same domain).
# VITE_LANDING_URL=http://localhost:3000

# Top-left RTT/FPS diagnostic overlay (true/false). Default false.
# Runtime override without a rebuild: append ?netstats=1 (or ?netstats=0) to the URL.
VITE_SHOW_NETSTATS=false
