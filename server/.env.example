# ========================================
# SOCKET.IO SERVER — environment variables
# ========================================
# Local dev: copy to `.env` (optional — sensible defaults exist).
# Production (Render): set CORS_ORIGIN in the service env. PORT is injected
# by Render automatically — do not set it there.

# --- Core ---
NODE_ENV=development
SOCKET_PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Arc testnet (chain 5042002) — ranked match escrow ---
# Reads (pot, joined, exists) need only the address, so the ranked stake panel works
# with ARC_PRIVATE_KEY blank. Settlement is the only thing that needs the key: with it
# unset the server logs "[arc] settlement disabled" and no-ops rather than throwing, so
# ranked matches play out but never pay out.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHASESTAKE_ADDRESS=0xD648def45026f437351D797dC3574fa97507BA83

# Settlement authority — posts settle() and moves the pot to the winner.
# KEEP SECRET. Server-side only; never expose as a NEXT_PUBLIC_ var.
ARC_PRIVATE_KEY=

# --- Faucet bot ---
# Separate wallet from settlement, on purpose. The faucet hands money to anyone who asks;
# the settlement key holds the escrow's authority. Sharing one wallet would mean a drained
# faucet is also a match that cannot pay out.
#
# New players are sent 2 USDC automatically on sign-in, once ever — claims are keyed by
# both wallet address and Privy user id in server/.faucet-claims.json and survive
# restarts. Budget roughly (balance - 1 USDC reserve) / 2 players.
#
# KEEP SECRET. Blank means the faucet is off (POST /arc/faucet answers 503).
FAUCET_PRIVATE_KEY=

# Port to listen on (local dev only; Render provides PORT).
# PORT=3001

# Comma-separated allowed browser origins. Unset = allow any origin (dev/demo).
# Production example: https://chase.abstractstudio.in
# CORS_ORIGIN=https://chase.abstractstudio.in


# ============================================================
# 0G — server-side ONLY. NEVER prefix with NEXT_PUBLIC_/VITE_.
# A funded key leaked to the browser spends real balance.
# Copy this file to server/.env for local dev; set the same
# vars in the Render dashboard for production.
# ============================================================

# --- 0G Compute Router (Phase 1: AI agent brains) ---
# Mainnet and testnet are SEPARATE: different web UI, endpoint, balance, and keys.
#   Testnet: UI https://pc.testnet.0g.ai  ->  OG_ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
#   Mainnet: UI https://pc.0g.ai          ->  OG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# Create an API key (copy the FULL secret shown once on creation) + deposit 0G.
OG_ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
OG_ROUTER_API_KEY=your-router-api-key-here
# Exact model id from the Models page — use a Chat model. NOTE: qwen2.5-omni does
# NOT support JSON mode (the code already handles this by parsing JSON from text).
OG_MODEL=qwen2.5-omni
# Seconds between agent-brain inference ticks (slow tier). Default 3.5.
OG_AGENT_TICK_SECONDS=3.5

# --- 0G testnet (Galileo) — Phase 2 Storage (verifiable replays) + Phase 3 Chain ---
# OG_PRIVATE_KEY is ONE funded Galileo testnet wallet (0x… 64-hex) used by BOTH the
# 0G Storage uploads and the on-chain leaderboard. Get test 0G from the Galileo faucet.
# When unset, Storage/Chain degrade gracefully (the game still finishes; results just
# show no verifiable hash). NEVER expose this to the browser.
OG_EVM_RPC=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
OG_PRIVATE_KEY=
# Phase 3 — deployed ChaseLeaderboard address (see contracts/). Leave blank until deployed.
OG_LEADERBOARD_ADDRESS=

# The Graph — ChaseStake subgraph (Subgraph Studio endpoint).
# The agent brains read player staking records from here to decide who to hunt.
# Unset is safe: agents fall back to purely spatial reasoning.
SUBGRAPH_URL=https://api.studio.thegraph.com/query/1760131/chase/0.98.1

# World ID — Selfie Check gate on the faucet (developer.world.org).
# With all three set, the faucet requires proof of human before it pays out, keyed on the
# World nullifier so one person cannot claim from ten emails. Unset, the faucet keeps its
# older address + userId keys and nobody is asked to verify.
WORLD_APP_ID=
WORLD_RP_ID=
# SECRET. Signs proof requests so nobody else can issue them in this app's name.
WORLD_SIGNING_KEY=
# "staging" routes to the World sandbox/simulator; "production" needs a real World App.
WORLD_ENVIRONMENT=staging
